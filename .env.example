# ===========================================================================
# INTERVIEW-BACKEND — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ===========================================================================
# Copiá este archivo como .env para desarrollo local o usá estas variables
# para configurar los Secrets en GitHub Actions y Azure Container Apps.
# NUNCA subas archivos .env con credenciales reales al repositorio.

# Puerto del servidor (por defecto 8080)
PORT=8080

# --- Base de Datos (MySQL) ---
# En desarrollo local con Docker Compose o contenedor mapeado:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/interviewai_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Hibernate DDL (update para dev, validate o none para prod)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# --- Pool de Conexiones HikariCP ---
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=1200000
HIKARI_LEAK_DETECTION_THRESHOLD=30000

# --- Seguridad y JWT ---
# OBLIGATORIA. No tiene valor por defecto: sin ella la aplicación no arranca.
# Mínimo 32 bytes (256 bits). jjwt elige el algoritmo según el largo:
#   32-47 bytes → HS256   ·   48-63 bytes → HS384   ·   64+ bytes → HS512
# Generala con:  openssl rand -base64 48
# Este valor es un EJEMPLO con la longitud correcta (48 bytes en Base64).
# No lo uses en producción: reemplazalo por una clave propia.
JWT_SECRET=cambia-esta-clave-por-una-generada-con-openssl-rand-base64-48
# Expiración en milisegundos (ej: 604800000 = 7 días)
JWT_EXPIRATION_MS=604800000

# --- Servicios Externos ---
# API Key de Groq para evaluación y generación de preguntas con IA
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
