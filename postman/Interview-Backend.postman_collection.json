          }
        },
        {
          "name": "Métricas de la aplicación (con token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Expone metricas de la aplicacion', function () {",
                  "    const names = pm.response.json().names;",
                  "    pm.expect(names).to.be.an('array');",
                  "    console.log('Metricas disponibles:', names.length);",
                  "});",
                  "pm.test('Incluye las metricas del pool de conexiones HikariCP', function () {",
                  "    const names = pm.response.json().names;",
                  "    pm.expect(names).to.include('hikaricp.connections.max');",
                  "});",
                  "pm.test('Incluye los tiempos de respuesta HTTP', function () {",
                  "    const names = pm.response.json().names;",
                  "    pm.expect(names).to.include('http.server.requests');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "metrics"]
            },
            "description": "Lista las 98 métricas disponibles (pool de conexiones, JVM, HTTP, GC)."
          }
        },
        {
          "name": "Tiempo de respuesta por endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Informa cantidad, tiempo total y la mas lenta', function () {",
                  "    const m = pm.response.json().measurements;",
                  "    const count = m.find(x => x.statistic === 'COUNT');",
                  "    const total = m.find(x => x.statistic === 'TOTAL_TIME');",
                  "    const max = m.find(x => x.statistic === 'MAX');",
                  "    pm.expect(count.value).to.be.above(0);",
                  "    console.log('Peticiones:', count.value, '| Tiempo total:', total.value.toFixed(4), 's | Mas lenta:', max.value.toFixed(4), 's');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
