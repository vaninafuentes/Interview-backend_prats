          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403', function () { pm.response.to.have.status(403); });",
                  "console.log('Correcto: modificar un solo caracter invalida la firma criptografica del token.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
